PORT=4000
# Orígenes del front que pueden usar la API (separados por coma)
CLIENT_URL=http://localhost:5173,https://comanda-bi.vercel.app

# PostgreSQL (Neon): DATABASE_URL y DATABASE_URL_UNPOOLED los escribe la CLI de Neon
# en server/.env.local con `neon deploy` o `neon env pull`. No los pegues aquí.

# Secreto para firmar los JWT del personal: una frase larga y aleatoria
JWT_SECRET=cambia-esto-por-un-secreto-largo
